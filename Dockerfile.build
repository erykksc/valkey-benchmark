FROM debian:13 AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    pkg-config \
    libssl-dev \
    wget \
    tcl \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN wget -qO- https://github.com/valkey-io/valkey/archive/refs/tags/9.0.1.tar.gz | \
    tar xz --strip-components=1

RUN make MALLOC=libc -j$(nproc)

RUN make test

FROM scratch
COPY --from=builder /build/src/valkey-server /
COPY --from=builder /build/src/valkey-cli /
