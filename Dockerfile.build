# ------------ VALKEY BUILD ------------
FROM debian:13 AS builder-valkey

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    pkg-config \
    libssl-dev \
    wget \
    tcl \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN wget -qO- https://github.com/valkey-io/valkey/archive/refs/tags/9.0.1.tar.gz | \
    tar xz --strip-components=1

RUN make MALLOC=libc -j$(nproc)

# RUN make test

# ------------ BENCHMARK BUILD ------------
FROM golang:1.25-trixie AS builder-benchmark

WORKDIR /benchmark

COPY go.mod go.sum .
RUN go mod download

COPY benchmark.go .

RUN CGO_ENABLED=0 go build -o my-valkey-benchmark .

# ------------ FINAL BUILD ------------
FROM scratch

COPY --from=builder-valkey /build/src/valkey-server /
COPY --from=builder-valkey /build/src/valkey-cli /
COPY --from=builder-valkey /build/src/valkey-benchmark /

COPY --from=builder-benchmark /benchmark/my-valkey-benchmark /
